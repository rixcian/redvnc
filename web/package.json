{
  "name": "@redvnc/web",
  "version": "0.1.0",
  "description": "React/TypeScript VNC browser client for redvnc",
  "type": "module",
  "main": "dist/index.cjs",
  "module": "dist/index.js",
  "types": "dist/index.d.ts",
  "exports": {
    ".": {
      "import": "./dist/index.js",
      "require": "./dist/index.cjs",
      "types": "./dist/index.d.ts"
